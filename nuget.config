<?xml version="1.0" encoding="utf-8"?>
<!-- Пакетов у проекта нет, но публикация под конкретный RID тянет runtime packs.
     Отрезаем унаследованные корпоративные источники и снимаем унаследованное
     отключение nuget.org — иначе restore не находит Microsoft.*.Runtime.win-x64. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <disabledPackageSources>
    <clear />
  </disabledPackageSources>
</configuration>
