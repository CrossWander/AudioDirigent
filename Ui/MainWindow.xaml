<Window x:Class="AudioDirigent.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:local="clr-namespace:AudioDirigent"
        Title="AudioDirigent"
        Icon="/app.ico"
        Width="880" Height="620" MinWidth="800" MinHeight="500"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Background="{DynamicResource Canvas}"
        TextOptions.TextFormattingMode="Ideal"
        FontFamily="Segoe UI Variable Display, Segoe UI"
        UseLayoutRounding="True">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="56" ResizeBorderThickness="6"
                            GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <!-- Окно показывают из трея, а не создают заново: появление отыгрывается сдвигом -->
    <Grid x:Name="Shell">
        <Grid.RenderTransform>
            <TranslateTransform/>
        </Grid.RenderTransform>

        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <local:TitleBar x:Name="Bar"/>

        <Grid Grid.Row="1" Margin="20,4,20,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <local:CurrentDevice x:Name="Current"/>
            <local:DeviceList x:Name="Devices" Grid.Row="1" Margin="0,16,0,0"/>
            <local:LogView x:Name="Log" Grid.Row="2" Margin="0,12,0,0"/>
        </Grid>

        <local:FooterBar x:Name="Footer" Grid.Row="2" Margin="20,14,20,16"/>

        <!-- Настройки не место в окне: их ставят один раз и больше к ним не возвращаются -->
        <Popup x:Name="SettingsMenu" Placement="Custom" StaysOpen="False"
               AllowsTransparency="True" PopupAnimation="Fade">
            <local:SettingsPanel x:Name="Settings" Margin="12"/>
        </Popup>
    </Grid>
</Window>
