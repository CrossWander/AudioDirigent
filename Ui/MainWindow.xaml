<Window x:Class="AudioDirigent.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="AudioDirigent"
        Icon="/app.ico"
        Width="880" Height="610" MinWidth="800" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Background="#0F1116"
        TextOptions.TextFormattingMode="Ideal"
        FontFamily="Segoe UI Variable Display, Segoe UI"
        UseLayoutRounding="True">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="56" ResizeBorderThickness="6"
                            GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <SolidColorBrush x:Key="Card" Color="#171A21"/>
        <SolidColorBrush x:Key="Line" Color="#262B36"/>
        <SolidColorBrush x:Key="Text" Color="#E8EAF0"/>
        <SolidColorBrush x:Key="TextDim" Color="#868D9D"/>
        <SolidColorBrush x:Key="Accent" Color="#E5352E"/>
        <SolidColorBrush x:Key="Good" Color="#35C46A"/>
        <SolidColorBrush x:Key="Muted" Color="#4A505E"/>
        <SolidColorBrush x:Key="Badge" Color="#232936"/>
        <SolidColorBrush x:Key="BadgeText" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="WatchingFill" Color="#16321F"/>
        <SolidColorBrush x:Key="WatchingLine" Color="#1F5233"/>
        <SolidColorBrush x:Key="PausedLine" Color="#39404E"/>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
        </Style>

        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextDim}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <!-- Кнопка с плавным ховером: свой Brush на экземпляр, иначе анимировать нечего -->
        <Style x:Key="Flat" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" CornerRadius="7" BorderThickness="1"
                                Padding="{TemplateBinding Padding}" RenderTransformOrigin="0.5,0.5">
                            <Border.Background>
                                <SolidColorBrush Color="#171A21"/>
                            </Border.Background>
                            <Border.BorderBrush>
                                <SolidColorBrush Color="#262B36"/>
                            </Border.BorderBrush>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                                <Setter Property="Cursor" Value="Wait"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="Chrome" Duration="0:0:0.13"
                                                            Storyboard.TargetProperty="Background.Color" To="#242A36"/>
                                            <ColorAnimation Storyboard.TargetName="Chrome" Duration="0:0:0.13"
                                                            Storyboard.TargetProperty="BorderBrush.Color" To="#3C4453"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="Chrome" Duration="0:0:0.2"
                                                            Storyboard.TargetProperty="Background.Color" To="#171A21"/>
                                            <ColorAnimation Storyboard.TargetName="Chrome" Duration="0:0:0.2"
                                                            Storyboard.TargetProperty="BorderBrush.Color" To="#262B36"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Кнопки заголовка окна -->
        <Style x:Key="WindowButton" TargetType="Button">
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Foreground" Value="{StaticResource TextDim}"/>
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" CornerRadius="6">
                            <Border.Background>
                                <SolidColorBrush Color="#00171A21"/>
                            </Border.Background>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource Text}"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="Chrome" Duration="0:0:0.12"
                                                            Storyboard.TargetProperty="Background.Color" To="#FF262C38"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="Chrome" Duration="0:0:0.2"
                                                            Storyboard.TargetProperty="Background.Color" To="#00171A21"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseButton" TargetType="Button" BasedOn="{StaticResource WindowButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" CornerRadius="6">
                            <Border.Background>
                                <SolidColorBrush Color="#00E5352E"/>
                            </Border.Background>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="White"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="Chrome" Duration="0:0:0.12"
                                                            Storyboard.TargetProperty="Background.Color" To="#FFE5352E"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="Chrome" Duration="0:0:0.2"
                                                            Storyboard.TargetProperty="Background.Color" To="#00E5352E"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Переключатель языка -->
        <!-- Переключатель без собственного вида: бейдж состояния сам себе кнопка -->
        <Style x:Key="BareToggle" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <ContentPresenter/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Плашка уровня в строке устройства: тусклая, пока громкость не закреплена -->
        <Style x:Key="LevelChip" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="MinWidth" Value="34"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" CornerRadius="6" Padding="6,3" BorderThickness="1"
                                Background="{TemplateBinding Background}" BorderBrush="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource Line}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Залитая часть дорожки - это DecreaseRepeatButton: иначе понадобился бы конвертер -->
        <Style x:Key="Level" TargetType="Slider">
            <Setter Property="IsMoveToPointEnabled" Value="True"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Height="20">
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="4" CornerRadius="2" VerticalAlignment="Center"
                                                        Background="{StaticResource Accent}"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="4" CornerRadius="2" VerticalAlignment="Center"
                                                        Background="{StaticResource Line}"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="14" Height="14">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Fill="{StaticResource Text}"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LangButton" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextDim}"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Chrome" CornerRadius="5" Padding="9,4" BorderThickness="1">
                            <Border.Background>
                                <SolidColorBrush Color="#00171A21"/>
                            </Border.Background>
                            <Border.BorderBrush>
                                <SolidColorBrush Color="#00262B36"/>
                            </Border.BorderBrush>
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="Chrome" Duration="0:0:0.12"
                                                            Storyboard.TargetProperty="Background.Color" To="#FF1E222C"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="Chrome" Duration="0:0:0.2"
                                                            Storyboard.TargetProperty="Background.Color" To="#00171A21"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource Text}"/>
                                <Setter TargetName="Chrome" Property="BorderBrush">
                                    <Setter.Value>
                                        <SolidColorBrush Color="#FFE5352E"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Тумблер с едущим кружком -->
        <Style x:Key="Toggle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="Track" Width="40" Height="22" CornerRadius="11" BorderThickness="1">
                                <Border.Background>
                                    <SolidColorBrush Color="#2A303C"/>
                                </Border.Background>
                                <Border.BorderBrush>
                                    <SolidColorBrush Color="#262B36"/>
                                </Border.BorderBrush>
                                <Ellipse x:Name="Knob" Width="16" Height="16" HorizontalAlignment="Left" Margin="2,0,0,0">
                                    <Ellipse.Fill>
                                        <SolidColorBrush Color="#8A91A0"/>
                                    </Ellipse.Fill>
                                    <Ellipse.RenderTransform>
                                        <TranslateTransform X="0"/>
                                    </Ellipse.RenderTransform>
                                </Ellipse>
                            </Border>
                            <ContentPresenter VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Knob" Duration="0:0:0.18" To="18"
                                                             Storyboard.TargetProperty="RenderTransform.X">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <ColorAnimation Storyboard.TargetName="Track" Duration="0:0:0.18"
                                                            Storyboard.TargetProperty="Background.Color" To="#E5352E"/>
                                            <ColorAnimation Storyboard.TargetName="Track" Duration="0:0:0.18"
                                                            Storyboard.TargetProperty="BorderBrush.Color" To="#E5352E"/>
                                            <ColorAnimation Storyboard.TargetName="Knob" Duration="0:0:0.18"
                                                            Storyboard.TargetProperty="Fill.Color" To="#FFFFFF"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Knob" Duration="0:0:0.18" To="0"
                                                             Storyboard.TargetProperty="RenderTransform.X">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <ColorAnimation Storyboard.TargetName="Track" Duration="0:0:0.18"
                                                            Storyboard.TargetProperty="Background.Color" To="#2A303C"/>
                                            <ColorAnimation Storyboard.TargetName="Track" Duration="0:0:0.18"
                                                            Storyboard.TargetProperty="BorderBrush.Color" To="#262B36"/>
                                            <ColorAnimation Storyboard.TargetName="Knob" Duration="0:0:0.18"
                                                            Storyboard.TargetProperty="Fill.Color" To="#8A91A0"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Строка устройства: появляется с лёгким сдвигом -->
        <Style x:Key="DeviceItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Row" CornerRadius="7" Padding="10,9" BorderThickness="1">
                            <Border.Background>
                                <SolidColorBrush Color="#0016191F"/>
                            </Border.Background>
                            <Border.BorderBrush>
                                <SolidColorBrush Color="#00262B36"/>
                            </Border.BorderBrush>
                            <Border.RenderTransform>
                                <TranslateTransform X="0"/>
                            </Border.RenderTransform>
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Row" Duration="0:0:0.22"
                                                         Storyboard.TargetProperty="Opacity" From="0" To="1"/>
                                        <DoubleAnimation Storyboard.TargetName="Row" Duration="0:0:0.22" From="-10" To="0"
                                                         Storyboard.TargetProperty="RenderTransform.X">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="Row" Duration="0:0:0.12"
                                                            Storyboard.TargetProperty="Background.Color" To="#FF1B1F28"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="Row" Duration="0:0:0.2"
                                                            Storyboard.TargetProperty="Background.Color" To="#0016191F"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Row" Property="Background">
                                    <Setter.Value>
                                        <SolidColorBrush Color="#FF232936"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="Row" Property="BorderBrush">
                                    <Setter.Value>
                                        <SolidColorBrush Color="#FF3C4453"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Border Background="Transparent" Padding="2,0">
                            <Track x:Name="PART_Track" IsDirectionReversed="True"
                                   Maximum="{TemplateBinding Maximum}" Minimum="{TemplateBinding Minimum}"
                                   Value="{TemplateBinding Value}" ViewportSize="{TemplateBinding ViewportSize}">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border CornerRadius="3" Background="#39404E" MinHeight="28"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
                                </Track.IncreaseRepeatButton>
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
                                </Track.DecreaseRepeatButton>
                            </Track>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Panel" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Card}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
        </Style>
    </Window.Resources>

    <Border x:Name="Root" BorderBrush="#262B36" BorderThickness="1" Background="#0F1116">
        <Grid x:Name="Shell" Margin="18,10,18,14" RenderTransformOrigin="0.5,0">
            <Grid.RenderTransform>
                <TranslateTransform Y="0"/>
            </Grid.RenderTransform>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Заголовок окна: он же шапка приложения -->
            <Grid Grid.Row="0" Height="46" Margin="0,0,0,12">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Grid Width="34" Height="34">
                        <Ellipse Fill="{StaticResource Accent}"/>
                        <Path Stroke="White" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Data="M 10,22 L 10,17 A 7,7 0 0 1 24,17 L 24,22"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="AudioDirigent" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Text="{DynamicResource langSubtitle}" Style="{StaticResource Caption}"
                                   FontWeight="Normal" Margin="0,1,0,0"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <Button x:Name="SettingsButton" Style="{StaticResource WindowButton}" Margin="0,0,8,0"
                            Click="OnSettingsMenu" ToolTip="{DynamicResource langSettings}">
                        <!-- Два ползунка: настройки, которые ставят один раз -->
                        <Path Data="M 0,3 H 11 M 0,9 H 11 M 3,1 V 5 M 8,7 V 11" StrokeThickness="1.3"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    </Button>
                    <Button Style="{StaticResource WindowButton}" Click="OnMinimize"
                            ToolTip="{DynamicResource langMinimize}">
                        <Path Data="M 0,0 H 11" StrokeThickness="1.3"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    </Button>
                    <Button x:Name="MaximizeButton" Style="{StaticResource WindowButton}" Click="OnMaximize"
                            ToolTip="{DynamicResource langMaximize}">
                        <Path Data="M 0,0 H 10 V 10 H 0 Z" StrokeThickness="1.3"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    </Button>
                    <Button Style="{StaticResource CloseButton}" Click="OnCloseToTray"
                            ToolTip="{DynamicResource langClose}">
                        <Path Data="M 0,0 L 10,10 M 10,0 L 0,10" StrokeThickness="1.3"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Текущее устройство -->
            <Border Grid.Row="1" Style="{StaticResource Panel}" Padding="18,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{DynamicResource langDefaultDevice}" Style="{StaticResource Caption}"/>
                        <TextBlock x:Name="CurrentDevice" Text="—" FontSize="20" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Ellipse x:Name="ProbeDot" Width="8" Height="8" Fill="{StaticResource Muted}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="ProbeStatus" Text="—" Foreground="{StaticResource TextDim}"
                                       FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>

                    <ToggleButton x:Name="PauseToggle" Grid.Column="1" VerticalAlignment="Top" Cursor="Hand"
                                  Style="{StaticResource BareToggle}" ToolTip="{DynamicResource langPauseHint}"
                                  Checked="OnPauseChanged" Unchecked="OnPauseChanged">
                        <Border x:Name="StateBadge" CornerRadius="8"
                                Background="#16321F" BorderBrush="#1F5233" BorderThickness="1" Padding="12,5">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="StateDot" Width="7" Height="7" Fill="{StaticResource Good}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="StateText" FontSize="12" FontWeight="SemiBold"
                                           Margin="7,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </ToggleButton>
                </Grid>
            </Border>

            <!-- Список устройств -->
            <Border Grid.Row="2" Style="{StaticResource Panel}" Margin="0,12,0,0" Padding="10,12">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="6,0,10,10">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="FlowOutput" Style="{StaticResource LangButton}" IsChecked="True"
                                         Content="{DynamicResource langOutput}" Tag="output" Checked="OnFlowChecked"/>
                            <RadioButton x:Name="FlowInput" Style="{StaticResource LangButton}"
                                         Content="{DynamicResource langInput}" Tag="input" Checked="OnFlowChecked"/>
                        </StackPanel>
                        <TextBlock x:Name="DeviceCount" Style="{StaticResource Caption}" FontWeight="Normal"
                                   HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>

                    <ListBox x:Name="Devices" Background="Transparent" BorderThickness="0"
                             ItemContainerStyle="{StaticResource DeviceItem}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             HorizontalContentAlignment="Stretch">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid AutomationProperties.Name="{Binding Name}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="30"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Width="22" Height="22" CornerRadius="6"
                                            Background="{Binding BadgeBackground}" HorizontalAlignment="Left"
                                            ToolTip="{Binding BadgeHint}">
                                        <TextBlock Text="{Binding Badge}" FontSize="11" FontWeight="Bold"
                                                   Foreground="{Binding BadgeForeground}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>

                                    <StackPanel Grid.Column="1" Margin="10,0,10,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontSize="13.5"
                                                   FontWeight="{Binding NameWeight}" Foreground="{Binding NameBrush}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Note}" Style="{StaticResource Caption}"
                                                   FontWeight="Normal" Margin="0,2,0,0"
                                                   Visibility="{Binding NoteVisibility}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Style="{StaticResource LevelChip}" Content="{Binding Level}"
                                                Background="{Binding LevelBackground}" Foreground="{Binding LevelForeground}"
                                                ToolTip="{Binding LevelHint}" Margin="0,0,16,0" Click="OnLevelChip"/>
                                        <Ellipse Width="7" Height="7" Fill="{Binding StateBrush}" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding State}" Foreground="{StaticResource TextDim}"
                                                   FontSize="12" Margin="7,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Кнопки -->
            <Grid Grid.Row="3" Margin="0,12,0,0">
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource Flat}" Content="{DynamicResource langMakePriority}" Click="OnMakePriority"/>
                    <Button Style="{StaticResource Flat}" Content="{DynamicResource langMakeBlocked}" Margin="8,0,0,0" Click="OnMakeBlocked"/>
                    <Button Style="{StaticResource Flat}" Content="{DynamicResource langClearRule}" Margin="8,0,0,0" Click="OnClearRule"/>
                    <Button Style="{StaticResource Flat}" Content="{DynamicResource langMoveUp}" Margin="16,0,0,0" MinWidth="78" Click="OnMoveUp"/>
                    <Button Style="{StaticResource Flat}" Content="{DynamicResource langMoveDown}" Margin="8,0,0,0" MinWidth="78" Click="OnMoveDown"/>
                </StackPanel>

                <!-- Кнопка действует на систему, а не на выделенное устройство: отделяем её краем ряда -->
                <Button x:Name="RecoverButton" Style="{StaticResource Flat}" HorizontalAlignment="Right"
                        Margin="16,0,0,0" Content="{DynamicResource langTrayRecover}"
                        ToolTip="{DynamicResource langRecoverHint}" Click="OnRecover"/>

                <!-- Настройки, которые ставят один раз: в ряду они только мешали бы -->
                <Popup x:Name="SettingsMenu" PlacementTarget="{Binding ElementName=SettingsButton}"
                       Placement="Custom" StaysOpen="False" AllowsTransparency="True">
                    <Border Style="{StaticResource Panel}" Padding="18,14" MaxWidth="340">
                        <StackPanel>
                            <CheckBox x:Name="AutostartToggle" Style="{StaticResource Toggle}"
                                      Content="{DynamicResource langAutostart}"
                                      Checked="OnAutostartChanged" Unchecked="OnAutostartChanged"/>
                            <TextBlock Text="{DynamicResource langAutostartHint}" Style="{StaticResource Caption}"
                                       FontWeight="Normal" Margin="50,4,0,0" TextWrapping="Wrap"/>

                            <CheckBox x:Name="UsbPowerToggle" Style="{StaticResource Toggle}" Margin="0,16,0,0"
                                      Content="{DynamicResource langUsbPower}"
                                      Checked="OnUsbPowerChanged" Unchecked="OnUsbPowerChanged"/>
                            <TextBlock Text="{DynamicResource langUsbPowerHint}" Style="{StaticResource Caption}"
                                       FontWeight="Normal" Margin="50,4,0,0" TextWrapping="Wrap"/>

                            <Border Height="1" Background="{StaticResource Line}" Margin="0,16,0,0"/>

                            <CheckBox x:Name="NotifyToggle" Margin="0,16,0,0" Style="{StaticResource Toggle}"
                                      Content="{DynamicResource langNotify}"
                                      Checked="OnNotifyChanged" Unchecked="OnNotifyChanged"/>
                            <TextBlock Text="{DynamicResource langNotifyHint}" Style="{StaticResource Caption}"
                                       FontWeight="Normal" Margin="50,4,0,0" TextWrapping="Wrap"/>

                            <CheckBox x:Name="PopupToggle" Margin="0,16,0,0" Style="{StaticResource Toggle}"
                                      Content="{DynamicResource langPopupSetting}"
                                      Checked="OnPopupChanged" Unchecked="OnPopupChanged"/>
                            <TextBlock Text="{DynamicResource langPopupSettingHint}" Style="{StaticResource Caption}"
                                       FontWeight="Normal" Margin="50,4,0,0" TextWrapping="Wrap"/>

                            <CheckBox x:Name="HotkeyToggle" Style="{StaticResource Toggle}" Margin="0,16,0,0"
                                      Content="{DynamicResource langHotkeys}"
                                      Checked="OnHotkeysChanged" Unchecked="OnHotkeysChanged"/>
                            <TextBlock x:Name="HotkeyHint" Style="{StaticResource Caption}"
                                       FontWeight="Normal" Margin="50,4,0,0" TextWrapping="Wrap"/>

                            <Border Height="1" Background="{StaticResource Line}" Margin="0,16,0,0"/>

                            <!-- Не настройка, а действие: в сеть выходим ровно по этой кнопке -->
                            <Grid Margin="0,16,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button x:Name="UpdateButton" Style="{StaticResource Flat}"
                                        Content="{DynamicResource langCheckUpdates}" Click="OnCheckUpdates"/>
                                <TextBlock x:Name="UpdateResult" Grid.Column="1" Style="{StaticResource Caption}"
                                           FontWeight="Normal" VerticalAlignment="Center" Margin="12,0,0,0"
                                           TextWrapping="Wrap" MouseLeftButtonUp="OnOpenReleases"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Popup>

                <!-- Громкость правит строку списка, поэтому попап цепляется к самой плашке -->
                <Popup x:Name="LevelMenu" Placement="Left" StaysOpen="False" AllowsTransparency="True"
                       Closed="OnLevelClosed">
                    <Border Style="{StaticResource Panel}" Padding="16,14" Width="300">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource langLevelHeader}" Style="{StaticResource Caption}"/>
                            <TextBlock x:Name="LevelDevice" Margin="0,8,0,0" FontSize="13" TextTrimming="CharacterEllipsis"/>

                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Slider x:Name="LevelSlider" Style="{StaticResource Level}" Maximum="100"
                                        VerticalAlignment="Center" ValueChanged="OnLevelChanged"/>
                                <TextBlock x:Name="LevelValue" Grid.Column="1" Margin="12,0,0,0" MinWidth="38"
                                           FontSize="13" FontWeight="SemiBold" TextAlignment="Right"
                                           VerticalAlignment="Center"/>
                            </Grid>

                            <TextBlock x:Name="LevelShared" Style="{StaticResource Caption}" FontWeight="Normal"
                                       Margin="0,10,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>

                            <Button Style="{StaticResource Flat}" Margin="0,14,0,0" HorizontalAlignment="Left"
                                    Content="{DynamicResource langLevelUnpin}" Click="OnLevelUnpin"/>
                        </StackPanel>
                    </Border>
                </Popup>

            </Grid>

            <!-- Журнал -->
            <Expander Grid.Row="4" Margin="2,12,0,0" Foreground="{StaticResource TextDim}" FontSize="12"
                      Expanded="OnLogExpanded" Collapsed="OnLogCollapsed">
                <Expander.Header>
                    <TextBlock Text="{DynamicResource langLog}" Style="{StaticResource Caption}"/>
                </Expander.Header>
                <Border x:Name="LogPanel" Style="{StaticResource Panel}" Margin="0,8,0,0" Padding="12,10" Height="130">
                    <ScrollViewer x:Name="LogScroll" VerticalScrollBarVisibility="Auto">
                        <TextBlock x:Name="Log" FontFamily="Cascadia Mono, Consolas" FontSize="11.5"
                                   Foreground="{StaticResource TextDim}" TextWrapping="Wrap"/>
                    </ScrollViewer>
                </Border>
            </Expander>

            <!-- Подвал: авторство и язык -->
            <Grid Grid.Row="5" Margin="2,14,2,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="Credits" Style="{StaticResource Caption}" FontWeight="Normal"/>
                    <TextBlock x:Name="UpdateLink" Style="{StaticResource Caption}" FontWeight="SemiBold"
                               Foreground="{StaticResource Good}" Cursor="Hand" Margin="12,0,0,0"
                               Visibility="Collapsed" MouseLeftButtonUp="OnOpenReleases"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <RadioButton x:Name="LangRu" Style="{StaticResource LangButton}" Content="RU" Tag="ru" Checked="OnLanguageChecked"/>
                    <RadioButton x:Name="LangUk" Style="{StaticResource LangButton}" Content="UA" Tag="uk" Checked="OnLanguageChecked"/>
                    <RadioButton x:Name="LangEn" Style="{StaticResource LangButton}" Content="EN" Tag="en" Checked="OnLanguageChecked"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
