<UserControl x:Class="AudioDirigent.FooterBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Служебная полоса: всё, что не про устройства, живёт одной строкой у нижнего края -->
    <Border BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Line}" Padding="0,12,0,0">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="Counts" Style="{DynamicResource Caption}" VerticalAlignment="Center"/>

                <!-- Про опрос говорим только там, где он настроен: у остальных это не новость -->
                <Ellipse x:Name="ProbeDot" Width="7" Height="7" Margin="14,0,7,0" VerticalAlignment="Center"
                         Visibility="Collapsed" Fill="{DynamicResource Muted}"/>
                <TextBlock x:Name="ProbeStatus" Style="{DynamicResource Caption}" VerticalAlignment="Center"
                           Visibility="Collapsed"/>
            </StackPanel>

            <!-- Новость о новой версии остаётся на глазах и после того, как настройки закрыли -->
            <TextBlock x:Name="UpdateLink" Grid.Column="1" Style="{DynamicResource Caption}" Margin="16,0"
                       VerticalAlignment="Center" Cursor="Hand" Visibility="Collapsed"
                       Foreground="{DynamicResource Accent}" TextDecorations="Underline"
                       MouseLeftButtonUp="OnOpenReleases"/>

            <TextBlock x:Name="Credits" Grid.Column="2" Style="{DynamicResource Caption}"
                       VerticalAlignment="Center" Margin="0,0,14,0"/>

            <Border Grid.Column="3" Style="{DynamicResource SegmentTrack}">
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="LangRu" Style="{DynamicResource Segment}" Tag="ru" Content="RU" Checked="OnLanguage"/>
                    <RadioButton x:Name="LangUk" Style="{DynamicResource Segment}" Tag="uk" Content="UA" Checked="OnLanguage"/>
                    <RadioButton x:Name="LangEn" Style="{DynamicResource Segment}" Tag="en" Content="EN" Checked="OnLanguage"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
