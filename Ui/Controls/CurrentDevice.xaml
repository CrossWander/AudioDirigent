<UserControl x:Class="AudioDirigent.CurrentDevice"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:AudioDirigent">

    <!-- Одна строка, а не карточка: то же имя стоит и в списке, и повторять его крупным
         шрифтом в рамке значило бы тратить на него полокна -->
    <Grid Margin="2,0,2,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <Ellipse x:Name="StateDot" Width="9" Height="9" Margin="0,0,12,0" VerticalAlignment="Center"
                 Fill="{DynamicResource Good}"/>

        <TextBlock x:Name="DeviceName" Grid.Column="1" Style="{DynamicResource Headline}" Text="—"
                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>

        <local:BatteryBar x:Name="Charge" Grid.Column="2" Margin="16,0,0,0" VerticalAlignment="Center"/>

        <Border x:Name="StateBadge" Grid.Column="3" Margin="16,0,0,0" CornerRadius="999" Padding="12,6"
                VerticalAlignment="Center" Cursor="Hand" MouseLeftButtonUp="OnBadgeClick"
                Background="{DynamicResource AccentFaint}">
            <StackPanel Orientation="Horizontal">
                <Ellipse x:Name="StateBadgeDot" Width="7" Height="7" VerticalAlignment="Center"
                         Fill="{DynamicResource Good}"/>
                <TextBlock x:Name="StateText" Style="{DynamicResource Caption}" Margin="7,0,0,0"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
