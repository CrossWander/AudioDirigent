<UserControl x:Class="AudioDirigent.CurrentDevice"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border Style="{DynamicResource Group}" Padding="20,16">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="{DynamicResource langDefaultDevice}" Style="{DynamicResource GroupHeader}" Margin="0,0,0,4"/>
                <TextBlock x:Name="DeviceName" Style="{DynamicResource Headline}" Text="—"/>

                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <TextBlock x:Name="DeviceCount" Style="{DynamicResource Caption}"/>
                    <Ellipse x:Name="ProbeDot" Width="7" Height="7" Margin="16,0,7,0" VerticalAlignment="Center"
                             Fill="{DynamicResource Muted}"/>
                    <TextBlock x:Name="ProbeStatus" Style="{DynamicResource Caption}"/>
                </StackPanel>
            </StackPanel>

            <!-- Значок состояния он же выключатель: щёлкнуть по нему — то же, что нажать паузу -->
            <Border x:Name="StateBadge" Grid.Column="1" VerticalAlignment="Center" Cursor="Hand"
                    CornerRadius="9" Padding="14,8" MouseLeftButtonUp="OnBadgeClick"
                    Background="{DynamicResource AccentFaint}" ToolTip="{DynamicResource langPauseHint}">
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="StateDot" Width="8" Height="8" VerticalAlignment="Center"
                             Fill="{DynamicResource Good}"/>
                    <TextBlock x:Name="StateText" Margin="8,0,0,0" FontWeight="SemiBold" FontSize="12"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
