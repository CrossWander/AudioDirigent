<UserControl x:Class="AudioDirigent.CurrentDevice"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:AudioDirigent">

    <!-- Одна строка, а не карточка: то же имя стоит и в списке, и повторять его крупным
         шрифтом в рамке значило бы тратить на него полокна -->
    <Grid Margin="2,0,2,0">
        <!-- Пустая доля справа, а не растянутое имя: заряд относится к устройству и
             должен стоять при нём. У правого края он читался как показание самого окна -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Та же поправка, что и у значка заряда: имя набрано двадцатым кеглем, и запас
             под хвосты букв у него заметнее — точка по середине строки встаёт выше букв -->
        <Ellipse x:Name="StateDot" Width="9" Height="9" Margin="0,3,12,0" VerticalAlignment="Center"
                 Fill="{DynamicResource Good}"/>

        <TextBlock x:Name="DeviceName" Grid.Column="1" Style="{DynamicResource Headline}" Text="—"
                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>

        <local:BatteryBar x:Name="Charge" Grid.Column="2" Margin="12,3,0,0" VerticalAlignment="Center"/>

    </Grid>
</UserControl>
