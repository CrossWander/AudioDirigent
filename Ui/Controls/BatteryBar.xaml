<UserControl x:Class="AudioDirigent.BatteryBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Visibility="Collapsed" ToolTip="{DynamicResource langChargeHint}">

    <StackPanel Orientation="Horizontal">
        <!-- Отступ сверху, а не ровная середина: строку меряют по высоте с запасом на
             хвосты букв, и значок, поставленный по её середине, встаёт выше цифр -->
        <Border Width="22" Height="11" CornerRadius="3" BorderThickness="1" Margin="0,2,0,0"
                BorderBrush="{DynamicResource TextDim}" VerticalAlignment="Center">
            <Rectangle x:Name="Fill" Fill="{DynamicResource Good}" Margin="1.5"
                       HorizontalAlignment="Left" RadiusX="1" RadiusY="1"/>
        </Border>
        <Border Width="2" Height="5" CornerRadius="0,1,1,0" Margin="1,2,0,0"
                Background="{DynamicResource TextDim}" VerticalAlignment="Center"/>
        <TextBlock x:Name="Percent" Margin="7,0,0,0" VerticalAlignment="Center"
                   FontSize="12" Foreground="{DynamicResource TextDim}"/>
    </StackPanel>
</UserControl>
