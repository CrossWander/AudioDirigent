<Window x:Class="AudioDirigent.Dialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ResizeMode="NoResize"
        Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI Variable Display, Segoe UI"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True">

    <!-- Внешние поля — место для тени: окно прозрачное, и тень рисуется внутри него -->
    <Border Style="{DynamicResource Group}" Padding="24,22" Margin="16" CornerRadius="14"
            MouseLeftButtonDown="OnDrag">
        <Border.Effect>
            <DropShadowEffect BlurRadius="26" ShadowDepth="7" Direction="270"
                              Opacity="{DynamicResource CardShadowOpacity}"/>
        </Border.Effect>

        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Восклицательный знак вырезан в самом треугольнике, а не положен поверх -->
                <Path Width="24" Height="24" Stretch="Uniform" VerticalAlignment="Top"
                      Margin="0,2,16,0" Fill="{DynamicResource Warn}"
                      Data="M12,1.8 L23.2,21.4 H0.8 Z M11,8.4 h2 v7 h-2 z M11,17 h2 v2.1 h-2 z"/>

                <StackPanel Grid.Column="1">
                    <TextBlock x:Name="Heading" FontSize="15" FontWeight="SemiBold"
                               TextWrapping="Wrap"/>
                    <TextBlock x:Name="Message" Style="{DynamicResource Caption}" Margin="0,8,0,0"
                               TextWrapping="Wrap" LineHeight="18"/>
                </StackPanel>
            </Grid>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                <Button x:Name="CancelButton" Style="{DynamicResource Flat}" MinWidth="100"
                        Content="{DynamicResource langCancel}" Margin="0,0,8,0" Click="OnCancel"/>
                <Button x:Name="OkButton" Style="{DynamicResource Primary}" MinWidth="100"
                        Content="{DynamicResource langOk}" IsDefault="True" Click="OnOk"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
