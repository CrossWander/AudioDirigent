<UserControl x:Class="AudioDirigent.NearbyPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:AudioDirigent">

    <Border Style="{DynamicResource Group}" Padding="18,16" Width="470">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="5" Direction="270"
                              Opacity="{DynamicResource CardShadowOpacity}"/>
        </Border.Effect>

        <StackPanel>
            <TextBlock Text="{DynamicResource langBluetooth}" Style="{DynamicResource GroupHeader}"/>

            <!-- Радиомодуля может не быть вовсе: тогда говорить больше не о чем -->
            <TextBlock x:Name="NoRadio" Text="{DynamicResource langBluetoothNoRadio}"
                       Style="{DynamicResource Caption}" TextWrapping="Wrap" Visibility="Collapsed"/>

            <TextBlock x:Name="Empty" Text="{DynamicResource langBluetoothEmpty}"
                       Style="{DynamicResource Caption}" TextWrapping="Wrap" Visibility="Collapsed"/>

            <ItemsControl x:Name="Rows" MaxHeight="320">
                <ItemsControl.Template>
                    <ControlTemplate TargetType="ItemsControl">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsPresenter/>
                        </ScrollViewer>
                    </ControlTemplate>
                </ItemsControl.Template>

                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type local:NearbyRow}">
                        <Grid Margin="0,7">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse x:Name="Dot" Width="7" Height="7" VerticalAlignment="Center"
                                             Margin="0,0,8,0" Fill="{DynamicResource Muted}"/>
                                    <TextBlock x:Name="RowName" Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <TextBlock Text="{Binding Note}" Style="{DynamicResource Caption}" Margin="15,2,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="PairButton" Style="{DynamicResource Primary}" Padding="10,6"
                                        Content="{DynamicResource langPair}" Visibility="Collapsed"
                                        Margin="0,0,6,0" Click="OnPair"/>
                                <Button x:Name="LinkButton" Style="{DynamicResource Flat}" Padding="10,6"
                                        MinWidth="104" Visibility="Collapsed" Margin="0,0,6,0"
                                        Content="{Binding Link}" Click="OnLink"/>
                                <!-- Галочка «не показывать»: радиомодуль слышит и чужие устройства -->
                                <CheckBox x:Name="HideBox" Style="{DynamicResource Tick}"
                                          IsChecked="{Binding Hidden, Mode=OneWay}"
                                          ToolTip="{DynamicResource langBluetoothHideHint}"
                                          Checked="OnHide" Unchecked="OnHide"/>
                            </StackPanel>
                        </Grid>

                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Connected}" Value="True">
                                <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource Good}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Paired}" Value="False">
                                <Setter TargetName="PairButton" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Linkable}" Value="True">
                                <Setter TargetName="LinkButton" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Hidden}" Value="True">
                                <Setter TargetName="RowName" Property="Foreground" Value="{DynamicResource TextFaint}"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Height="1" Background="{DynamicResource Line}" Margin="0,14,0,0"/>

            <CheckBox x:Name="ShowHiddenToggle" Style="{DynamicResource Toggle}" Margin="0,14,0,0"
                      Content="{DynamicResource langBluetoothShowHidden}"
                      Checked="OnShowHidden" Unchecked="OnShowHidden"/>

            <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="ScanButton" Style="{DynamicResource Flat}"
                        Content="{DynamicResource langBluetoothScan}" Click="OnScan"/>
                <TextBlock x:Name="ScanNote" Grid.Column="1" Style="{DynamicResource Caption}"
                           Margin="12,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap"
                           Text="{DynamicResource langBluetoothScanHint}"/>
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
