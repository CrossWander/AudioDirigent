<UserControl x:Class="AudioDirigent.DeviceList"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:AudioDirigent">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,10">
            <!-- Направления: у вывода и записи свои правила, а таблица одна -->
            <Border Style="{DynamicResource SegmentTrack}" HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="OutputTab" Style="{DynamicResource Segment}" IsChecked="True" Tag="output"
                                 Content="{DynamicResource langOutput}" Checked="OnFlowChecked"/>
                    <RadioButton x:Name="InputTab" Style="{DynamicResource Segment}" Tag="input"
                                 Content="{DynamicResource langInput}" Checked="OnFlowChecked"/>
                </StackPanel>
            </Border>

            <!-- Действует на систему, а не на строку: потому и стоит у другого края -->
            <Button x:Name="RecoverButton" Style="{DynamicResource Flat}" HorizontalAlignment="Right"
                    VerticalAlignment="Center" Content="{DynamicResource langTrayRecover}"
                    ToolTip="{DynamicResource langRecoverHint}" Click="OnRecover"/>
        </Grid>

        <!--
            Шапка колонок. Без неё «—», «60%» и «отключено» стоят у правого края тремя
            числами без объяснения, а «сверху вниз» приходится угадывать по номерам.
        -->
        <Grid Grid.Row="1" Margin="6,0,6,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="70"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{DynamicResource langRuleTopDown}" Style="{DynamicResource Caption}"
                           FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFaint}"/>
                <Border Height="1" Width="240" Margin="12,1,0,0" VerticalAlignment="Center"
                        Background="{DynamicResource Line}"/>
            </StackPanel>

            <TextBlock Grid.Column="1" Text="{DynamicResource langColumnLevel}" Margin="12,0"
                       MinWidth="42" TextAlignment="Right" FontSize="11"
                       Style="{DynamicResource Caption}" Foreground="{DynamicResource TextFaint}"/>
            <TextBlock Grid.Column="2" Text="{DynamicResource langColumnCharge}" Margin="0,0,14,0"
                       MinWidth="52" TextAlignment="Right" FontSize="11"
                       Style="{DynamicResource Caption}" Foreground="{DynamicResource TextFaint}"/>
            <TextBlock Grid.Column="3" Text="{DynamicResource langColumnState}"
                       MinWidth="92" TextAlignment="Right" FontSize="11"
                       Style="{DynamicResource Caption}" Foreground="{DynamicResource TextFaint}"/>
        </Grid>

        <Grid Grid.Row="2">
            <ListBox x:Name="Rows" Background="Transparent" BorderThickness="0"
                     ItemContainerStyle="{DynamicResource ListRow}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     SelectionChanged="OnSelected"
                     HorizontalContentAlignment="Stretch">

                <ListBox.Resources>

                    <!-- Заголовок раздела: та же строка списка, только вместо устройства — счёт -->
                    <DataTemplate DataType="{x:Type local:SectionRow}">
                        <Button Style="{DynamicResource Band}" Click="OnSection">
                            <StackPanel Orientation="Horizontal">
                                <Path x:Name="Fold" Width="9" Height="9" Margin="0,0,10,0" VerticalAlignment="Center"
                                      Stroke="{DynamicResource TextFaint}" StrokeThickness="1.4"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Data="M0,0 L4.5,4.5 L0,9" RenderTransformOrigin="0.5,0.5"/>
                                <TextBlock Text="{Binding Title}" Style="{DynamicResource Caption}"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Count}" Style="{DynamicResource Caption}"
                                           Margin="8,0,0,0" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextFaint}"/>
                            </StackPanel>
                        </Button>

                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Open}" Value="True">
                                <Setter TargetName="Fold" Property="RenderTransform">
                                    <Setter.Value>
                                        <RotateTransform Angle="90"/>
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>

                    <DataTemplate DataType="{x:Type local:DeviceRow}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Очередь правила двигают здесь же: место в ней видно только рядом с ним -->
                                <StackPanel x:Name="Ladder" Width="16" VerticalAlignment="Center" Visibility="Hidden">
                                    <Button Style="{DynamicResource Glyph}" Width="16" Height="14" Click="OnRaise"
                                            IsEnabled="{Binding CanRaise}" ToolTip="{DynamicResource langMoveUp}">
                                        <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              StrokeLineJoin="Round" Data="M0,4 L3.5,0 L7,4"/>
                                    </Button>
                                    <Button Style="{DynamicResource Glyph}" Width="16" Height="14" Click="OnLower"
                                            IsEnabled="{Binding CanLower}" ToolTip="{DynamicResource langMoveDown}">
                                        <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              StrokeLineJoin="Round" Data="M0,0 L3.5,4 L7,0"/>
                                    </Button>
                                </StackPanel>

                                <TextBlock x:Name="MarkText" Grid.Column="1" Text="{Binding Badge}" FontSize="12"
                                           Width="20" TextAlignment="Center" VerticalAlignment="Center"
                                           Margin="4,0,10,0" ToolTip="{Binding BadgeHint}"
                                           Foreground="{DynamicResource TextDim}"/>

                                <Ellipse x:Name="StateDot" Grid.Column="2" Width="8" Height="8" Margin="0,0,12,0"
                                         VerticalAlignment="Center" Fill="{DynamicResource Muted}"/>

                                <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                    <TextBlock x:Name="RowName" Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock x:Name="RowNote" Text="{DynamicResource langCurrentDevice}"
                                               Style="{DynamicResource Caption}" Margin="0,2,0,0"
                                               Foreground="{DynamicResource Accent}" Visibility="Collapsed"/>
                                </StackPanel>

                                <!-- Уровень теперь показание, а не кнопка: правят его в раскрытой строке -->
                                <TextBlock x:Name="LevelText" Grid.Column="4" Margin="12,0" VerticalAlignment="Center"
                                           MinWidth="42" TextAlignment="Right"
                                           Style="{DynamicResource Caption}" Text="{Binding Level}"
                                           ToolTip="{Binding LevelHint}"/>

                                <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Charge}" Style="{DynamicResource Caption}"
                                               MinWidth="52" TextAlignment="Right" Margin="0,0,14,0"
                                               ToolTip="{DynamicResource langChargeHint}"/>
                                    <TextBlock Text="{Binding State}" Style="{DynamicResource Caption}"
                                               MinWidth="92" TextAlignment="Right"/>
                                </StackPanel>

                                <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Center"
                                            Margin="14,0,0,0">
                                    <!-- Правило меняют там, где оно написано: в самой строке -->
                                    <Button x:Name="Join" Style="{DynamicResource Glyph}" Width="26" Height="26"
                                            Click="OnJoin" ToolTip="{DynamicResource langMakePriority}">
                                        <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              Data="M4.5,0 L4.5,9 M0,4.5 L9,4.5"/>
                                    </Button>
                                    <Button x:Name="Drop" Style="{DynamicResource Glyph}" Width="26" Height="26"
                                            Visibility="Collapsed" Click="OnDrop"
                                            ToolTip="{DynamicResource langClearRule}">
                                        <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              Data="M0,0 L9,9 M9,0 L0,9"/>
                                    </Button>

                                    <!-- Шеврон: то же, что и щелчок по строке, но видимый -->
                                    <Button x:Name="Chevron" Style="{DynamicResource Glyph}"
                                            Width="28" Height="28" Margin="2,0,0,0" Click="OnChevron"
                                            ToolTip="{DynamicResource langRowExpand}">
                                        <Path x:Name="Arrow"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              StrokeLineJoin="Round" Data="M0,0 L4.5,4.5 L9,0"
                                              RenderTransformOrigin="0.5,0.5"/>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <!--
                                Раскрытая строка: слева то, что задаёте вы, справа то, что
                                отвечает устройство. Одной колонкой это было восемь этажей
                                подряд — ползунок, галочка, подпись, полоска, число, кнопка,
                                приговор, ручки железа, — и связи между ними не читались.
                            -->
                            <Grid x:Name="Detail" Visibility="Collapsed" Margin="50,14,4,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="30"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <StackPanel x:Name="LevelGroup">
                                        <TextBlock Text="{Binding LevelName}" Style="{DynamicResource GroupHeader}"/>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Slider x:Name="LevelSlider" Minimum="0" Maximum="100" VerticalAlignment="Center"
                                                    Value="{Binding Volume, Mode=OneWay}" ValueChanged="OnVolumeChanged"/>
                                            <TextBlock Grid.Column="1" MinWidth="46" TextAlignment="Right"
                                                       VerticalAlignment="Center" Style="{DynamicResource Caption}"
                                                       Text="{Binding Value, ElementName=LevelSlider, StringFormat={}{0:0}%}"/>
                                        </Grid>

                                        <CheckBox x:Name="HoldToggle" Style="{DynamicResource Toggle}" Margin="0,14,0,0"
                                                  Content="{DynamicResource langLevelHold}"
                                                  IsChecked="{Binding Hold, Mode=OneWay}"
                                                  Checked="OnHoldChanged" Unchecked="OnHoldChanged"/>
                                        <TextBlock Text="{DynamicResource langLevelHoldHint}" Style="{DynamicResource Caption}"
                                                   Margin="0,4,12,0" TextWrapping="Wrap"/>
                                        <TextBlock x:Name="SharedNote" Text="{Binding Shared}" Style="{DynamicResource Caption}"
                                                   Margin="0,6,12,0" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource Warn}"/>
                                    </StackPanel>

                                    <!-- Что умеет само устройство: у кого-то усиление, у кого-то ничего -->
                                    <StackPanel x:Name="KnobGroup" Margin="0,20,0,0" Visibility="Collapsed">
                                        <TextBlock Text="{DynamicResource langDetailKnobs}" Style="{DynamicResource GroupHeader}"/>

                                        <ItemsControl ItemsSource="{Binding Knobs}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type local:KnobRow}">
                                                    <StackPanel Margin="0,10,0,0">
                                                        <TextBlock x:Name="KnobName" Text="{Binding Name}" Style="{DynamicResource Caption}"/>

                                                        <Grid x:Name="KnobLevel" Margin="0,5,0,0">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Slider x:Name="KnobSlider" Minimum="{Binding Minimum}" Maximum="{Binding Maximum}"
                                                                    Value="{Binding Value, Mode=OneTime}"
                                                                    TickFrequency="{Binding Step}" IsSnapToTickEnabled="{Binding Snap}"
                                                                    VerticalAlignment="Center" ValueChanged="OnKnobChanged"/>
                                                            <!-- Подпись читает сам ползунок: иначе её пришлось бы догонять из кода -->
                                                            <TextBlock Grid.Column="1" MinWidth="58" TextAlignment="Right"
                                                                       VerticalAlignment="Center" Style="{DynamicResource Caption}"
                                                                       Text="{Binding Value, ElementName=KnobSlider, StringFormat={}{0:+0.#;-0.#;0} dB}"/>
                                                        </Grid>

                                                        <CheckBox x:Name="KnobSwitch" Style="{DynamicResource Toggle}"
                                                                  Content="{Binding Name}" IsChecked="{Binding On, Mode=OneTime}"
                                                                  Checked="OnKnobToggled" Unchecked="OnKnobToggled"/>
                                                    </StackPanel>

                                                    <DataTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding IsLevel}" Value="True">
                                                            <Setter TargetName="KnobSwitch" Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsLevel}" Value="False">
                                                            <Setter TargetName="KnobName" Property="Visibility" Value="Collapsed"/>
                                                            <Setter TargetName="KnobLevel" Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!-- Молчание здесь неотличимо от недоделки -->
                                        <TextBlock x:Name="BareNote" Text="{DynamicResource langDeviceBare}"
                                                   Style="{DynamicResource Caption}" Margin="0,4,12,0"
                                                   TextWrapping="Wrap" Visibility="Collapsed"/>
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <!-- Чувствительность на слух не выставить: полоска показывает, где перегруз -->
                                    <StackPanel x:Name="SignalGroup" Visibility="Collapsed">
                                        <TextBlock Text="{DynamicResource langDetailSignal}" Style="{DynamicResource GroupHeader}"/>

                                        <Grid Margin="0,2,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <ProgressBar Style="{DynamicResource Meter}" VerticalAlignment="Center"
                                                         Value="{Binding Peak}"/>
                                            <TextBlock Grid.Column="1" MinWidth="46" TextAlignment="Right"
                                                       VerticalAlignment="Center" Style="{DynamicResource Caption}"
                                                       Text="{Binding PeakText}"/>
                                        </Grid>

                                        <!-- Число в децибелах само по себе ничего не говорит: нужен приговор -->
                                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                            <Button x:Name="CheckButton" Style="{DynamicResource Flat}"
                                                    Content="{DynamicResource langCheckMic}" Click="OnCheck"/>
                                            <TextBlock x:Name="Verdict" Text="{Binding Verdict}" Margin="12,0,0,0"
                                                       VerticalAlignment="Center" Style="{DynamicResource Caption}"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Заряд, которого Windows не знает: устройство кричит его в эфир,
                                         но какое из объявлений чьё — знает только человек -->
                                    <StackPanel x:Name="ChargeGroup" Margin="0,20,0,0" Visibility="Collapsed">
                                        <TextBlock Text="{DynamicResource langDetailCharge}" Style="{DynamicResource GroupHeader}"/>

                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                            <Button x:Name="BindButton" Style="{DynamicResource Flat}"
                                                    Content="{DynamicResource langBindCharge}" Click="OnBind"/>
                                            <TextBlock x:Name="BindNote" Text="{Binding BindNote}" Margin="12,0,0,0"
                                                       VerticalAlignment="Center" Style="{DynamicResource Caption}"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Редкие решения живут здесь, а не в панели под списком:
                                         та относилась неизвестно к какой строке -->
                                    <StackPanel Margin="0,20,0,0">
                                        <TextBlock Text="{DynamicResource langDetailRule}" Style="{DynamicResource GroupHeader}"/>

                                        <WrapPanel Margin="0,2,0,0">
                                            <Button x:Name="MakeMainButton" Style="{DynamicResource Primary}"
                                                    Visibility="Collapsed" Margin="0,0,8,8"
                                                    Content="{DynamicResource langPopupMakeMain}" Click="OnMakeMain"/>
                                            <Button x:Name="LinkButton" Style="{DynamicResource Flat}" Visibility="Collapsed"
                                                    Margin="0,0,8,8" MinWidth="112" Click="OnLink"
                                                    Content="{Binding LinkText}"/>
                                            <Button x:Name="BlockButton" Style="{DynamicResource Flat}" Margin="0,0,8,8"
                                                    Content="{DynamicResource langMakeBlocked}" Click="OnMakeBlocked"/>
                                        </WrapPanel>

                                        <TextBlock Text="{Binding BadgeHint}" Style="{DynamicResource Caption}"
                                                   Margin="0,2,12,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </StackPanel>

                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding CanMakeMain}" Value="True">
                                <Setter TargetName="MakeMainButton" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding CanLink}" Value="True">
                                <Setter TargetName="LinkButton" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding InRule}" Value="True">
                                <Setter TargetName="Ladder" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="Join" Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="Drop" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Mark}" Value="Blocked">
                                <Setter TargetName="MarkText" Property="Foreground" Value="{DynamicResource Bad}"/>
                                <Setter TargetName="Join" Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="Drop" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="BlockButton" Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Mark}" Value="Undecided">
                                <Setter TargetName="MarkText" Property="Foreground" Value="{DynamicResource Accent}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Active}" Value="True">
                                <Setter TargetName="StateDot" Property="Fill" Value="{DynamicResource Good}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Current}" Value="True">
                                <Setter TargetName="RowName" Property="FontWeight" Value="SemiBold"/>
                                <Setter TargetName="RowNote" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Pinned}" Value="True">
                                <Setter TargetName="LevelText" Property="Foreground" Value="{DynamicResource Text}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Capture}" Value="True">
                                <Setter TargetName="SignalGroup" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="KnobGroup" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Active}" Value="False">
                                <Setter TargetName="RowName" Property="Foreground" Value="{DynamicResource TextFaint}"/>
                                <Setter TargetName="LevelGroup" Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="SignalGroup" Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="KnobGroup" Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Testing}" Value="True">
                                <Setter TargetName="CheckButton" Property="IsEnabled" Value="False"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding VerdictGood}" Value="True">
                                <Setter TargetName="Verdict" Property="Foreground" Value="{DynamicResource Good}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding VerdictGood}" Value="False">
                                <Setter TargetName="Verdict" Property="Foreground" Value="{DynamicResource Warn}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding CanBind}" Value="True">
                                <Setter TargetName="ChargeGroup" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Pairing}" Value="True">
                                <Setter TargetName="BindButton" Property="IsEnabled" Value="False"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Bare}" Value="True">
                                <Setter TargetName="BareNote" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Shared}" Value="{x:Null}">
                                <Setter TargetName="SharedNote" Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Expanded}" Value="True">
                                <Setter TargetName="Detail" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="Arrow" Property="RenderTransform">
                                    <Setter.Value>
                                        <RotateTransform Angle="180"/>
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>

                </ListBox.Resources>
            </ListBox>
        </Grid>
    </Grid>
</UserControl>
