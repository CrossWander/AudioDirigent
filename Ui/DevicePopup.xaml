<Window x:Class="AudioDirigent.DevicePopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AudioDirigent"
        Width="330" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ShowActivated="False" Topmost="True"
        FontFamily="Segoe UI Variable Display, Segoe UI"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True">

    <Window.Resources>
        <!-- Палитра повторяет главное окно: попап живёт отдельно от него и открывается,
             когда окна нет вовсе, поэтому свои кисти ему нужны свои -->
        <SolidColorBrush x:Key="Card" Color="#171A21"/>
        <SolidColorBrush x:Key="Line" Color="#262B36"/>
        <SolidColorBrush x:Key="Text" Color="#E8EAF0"/>
        <SolidColorBrush x:Key="TextDim" Color="#868D9D"/>
        <SolidColorBrush x:Key="Good" Color="#35C46A"/>

        <!-- Один набор рисунков на все устройства: у эппловского попапа узнаваем именно
             единый стиль, а системные значки у каждого устройства свои и разной выделки -->
        <Geometry x:Key="IconHeadphones">M12,3 C7.03,3 3,7.03 3,12 v7 a2,2 0 0 0 2,2 h3 v-9 H5.5 v-1 c0,-3.59 2.91,-6.5 6.5,-6.5 s6.5,2.91 6.5,6.5 v1 H16 v9 h3 a2,2 0 0 0 2,-2 v-7 c0,-4.97 -4.03,-9 -9,-9 z</Geometry>
        <Geometry x:Key="IconSpeakers">F0 M6.5,2 h11 a2,2 0 0 1 2,2 v16 a2,2 0 0 1 -2,2 h-11 a2,2 0 0 1 -2,-2 V4 a2,2 0 0 1 2,-2 z M12,4.6 a2,2 0 1 0 0,4 a2,2 0 0 0 0,-4 z M12,11.4 a4.3,4.3 0 1 0 0,8.6 a4.3,4.3 0 0 0 0,-8.6 z M12,13.4 a2.3,2.3 0 1 1 0,4.6 a2.3,2.3 0 0 1 0,-4.6 z</Geometry>
        <Geometry x:Key="IconMicrophone">M12,14.5 a3.2,3.2 0 0 0 3.2,-3.2 V5 a3.2,3.2 0 0 0 -6.4,0 v6.3 a3.2,3.2 0 0 0 3.2,3.2 z M17.6,11.3 a5.6,5.6 0 0 1 -11.2,0 H4.6 a7.4,7.4 0 0 0 6.5,7.3 V22 h1.8 v-3.4 a7.4,7.4 0 0 0 6.5,-7.3 z</Geometry>
        <Geometry x:Key="IconScreen">F0 M3,4 h18 a1.5,1.5 0 0 1 1.5,1.5 v10 a1.5,1.5 0 0 1 -1.5,1.5 H3 a1.5,1.5 0 0 1 -1.5,-1.5 V5.5 A1.5,1.5 0 0 1 3,4 z M3.5,6 v9 h17 V6 z M8,19 h8 v1.8 H8 z</Geometry>
        <Geometry x:Key="IconSound">M12,4 L7,8.5 H3 v7 h4 L12,20 z M15.6,8.4 a5,5 0 0 1 0,7.2 l1.4,1.4 a7,7 0 0 0 0,-10 z</Geometry>

        <!-- Кнопка появляется в попапе с единственным действием, и это действие
             утвердительное: красим её заметнее, чем кнопки в окне -->
        <Style x:Key="PopupAction" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" CornerRadius="9" BorderThickness="1"
                                Padding="{TemplateBinding Padding}">
                            <Border.Background>
                                <SolidColorBrush Color="#20262F"/>
                            </Border.Background>
                            <Border.BorderBrush>
                                <SolidColorBrush Color="#30394A"/>
                            </Border.BorderBrush>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="Chrome" Duration="0:0:0.13"
                                                            Storyboard.TargetProperty="Background.Color" To="#2B3442"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="Chrome" Duration="0:0:0.2"
                                                            Storyboard.TargetProperty="Background.Color" To="#20262F"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Внешние поля — место для тени: окно прозрачное, и тень рисуется внутри него -->
    <Grid Margin="18,14,18,18" RenderTransformOrigin="0.5,1">
        <Grid.RenderTransform>
            <TranslateTransform x:Name="Slide"/>
        </Grid.RenderTransform>

        <Border Background="{StaticResource Card}" BorderBrush="{StaticResource Line}"
                BorderThickness="1" CornerRadius="16" Padding="16,15">
            <Border.Effect>
                <DropShadowEffect BlurRadius="22" ShadowDepth="6" Direction="270" Opacity="0.5" Color="#000000"/>
            </Border.Effect>

            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Viewbox Width="38" Height="38" VerticalAlignment="Top" Margin="0,1,14,0">
                        <Path x:Name="DeviceIcon" Fill="{StaticResource Text}" Width="24" Height="24" Stretch="Uniform"/>
                    </Viewbox>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="DeviceName" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{StaticResource Text}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="Status" FontSize="12" Margin="0,3,0,0"
                                   Foreground="{StaticResource TextDim}" TextWrapping="Wrap"/>

                        <!-- Заряд отдают немногие устройства: строки просто нет, когда его нет -->
                        <StackPanel x:Name="BatteryRow" Orientation="Horizontal" Margin="0,7,0,0"
                                    Visibility="Collapsed">
                            <Border Width="22" Height="11" CornerRadius="3" BorderThickness="1"
                                    BorderBrush="{StaticResource TextDim}" VerticalAlignment="Center">
                                <Rectangle x:Name="BatteryFill" Fill="{StaticResource Good}" Margin="1.5"
                                           HorizontalAlignment="Left" RadiusX="1" RadiusY="1"/>
                            </Border>
                            <Border Width="2" Height="5" CornerRadius="0,1,1,0" Margin="1,0,0,0"
                                    Background="{StaticResource TextDim}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="BatteryText" FontSize="12" Margin="7,0,0,0"
                                       VerticalAlignment="Center" Foreground="{StaticResource TextDim}"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <Button x:Name="Action" Style="{StaticResource PopupAction}" Margin="0,14,0,0"
                        Visibility="Collapsed" Click="OnAction"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
