<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Тёмная тема. Те же роли, что и в светлой: меняются только значения, и потому
         разметка о теме не знает вовсе — она обращается к ролям через DynamicResource. -->

    <SolidColorBrush x:Key="Canvas" Color="#1C1C1E"/>
    <SolidColorBrush x:Key="Surface" Color="#2C2C2E"/>
    <SolidColorBrush x:Key="SurfaceAlt" Color="#323234"/>
    <SolidColorBrush x:Key="Hover" Color="#3A3A3C"/>
    <SolidColorBrush x:Key="Selected" Color="#454548"/>

    <SolidColorBrush x:Key="Text" Color="#F2F2F7"/>
    <SolidColorBrush x:Key="TextDim" Color="#9B9BA1"/>
    <SolidColorBrush x:Key="TextFaint" Color="#6C6C72"/>

    <SolidColorBrush x:Key="Line" Color="#3A3A3C"/>

    <SolidColorBrush x:Key="Good" Color="#30D158"/>
    <SolidColorBrush x:Key="Warn" Color="#FF9F0A"/>
    <SolidColorBrush x:Key="Bad" Color="#FF453A"/>
    <SolidColorBrush x:Key="Muted" Color="#5A5A5F"/>

    <SolidColorBrush x:Key="BadgeFill" Color="#3A3A3C"/>
    <SolidColorBrush x:Key="BadgeText" Color="#F2F2F7"/>

    <sys:Double xmlns:sys="clr-namespace:System;assembly=System.Runtime" x:Key="CardShadowOpacity">0.5</sys:Double>

</ResourceDictionary>
