<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Светлая тема. Плоскостей всего две: полотно окна и приподнятая над ним группа.
         Строки внутри группы разделяет не линия, а чередование тона — тем самым приёмом
         системные списки обходятся без рамок и остаются читаемыми. -->

    <SolidColorBrush x:Key="Canvas" Color="#F2F2F7"/>
    <SolidColorBrush x:Key="Surface" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SurfaceAlt" Color="#FAFAFC"/>
    <SolidColorBrush x:Key="Hover" Color="#EDEDF2"/>
    <SolidColorBrush x:Key="Selected" Color="#E4E4EC"/>

    <SolidColorBrush x:Key="Text" Color="#1C1C1E"/>
    <SolidColorBrush x:Key="TextDim" Color="#6E6E76"/>
    <SolidColorBrush x:Key="TextFaint" Color="#A0A0A8"/>

    <!-- Линии остались там, где без них никак: край группы и отбивка блоков настроек -->
    <SolidColorBrush x:Key="Line" Color="#E0E0E6"/>

    <SolidColorBrush x:Key="Good" Color="#248A3D"/>
    <SolidColorBrush x:Key="Warn" Color="#B25000"/>
    <SolidColorBrush x:Key="Bad" Color="#C7302B"/>
    <SolidColorBrush x:Key="Muted" Color="#B4B4BC"/>

    <SolidColorBrush x:Key="BadgeFill" Color="#E8E8EE"/>
    <SolidColorBrush x:Key="BadgeText" Color="#3C3C43"/>

    <!-- Тень карточки над треем: на светлом полотне та же глубина выглядит грязью -->
    <sys:Double xmlns:sys="clr-namespace:System;assembly=System.Runtime" x:Key="CardShadowOpacity">0.22</sys:Double>

</ResourceDictionary>
